{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jdot offline session summary",
  "description": "A pending summary, not a Page save receipt. The CLI also enforces at most 120 whitespace-delimited words across bullets.",
  "type": "object",
  "required": ["schema_version", "session_id", "recorded_at", "bullets"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "session_id": {"type": "string", "format": "uuid"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "bullets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S", "not": {"pattern": "[\\u0000-\\u001f\\u007f\\u0085\\u2028\\u2029]"}}
    }
  }
}
